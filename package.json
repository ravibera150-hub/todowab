{
  "name": "wad-todolist-app",
  "version": "1.0.0",
  "description": "Full-Stack To-Do List Web Application for Academic WAD Project",
  "scripts": {
    "dev": "npm run client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "test": "cd server && npm test",
    "build": "cd client && npx vite build --outDir ../dist",
    "vercel-build": "cd client && npx vite build --outDir ../dist",
    "postinstall": "cd client && npm install"
  },
  "keywords": [
    "react",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "custom-css",
    "wad-project"
  ],
  "author": "WAD Student",
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.0.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^6.0.7"
  }
}
