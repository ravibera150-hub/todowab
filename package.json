{
  "name": "wad-todolist-app",
  "version": "1.0.0",
  "description": "Full-Stack To-Do List Web Application for Academic WAD Project",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "build": "cd client && npx vite build --outDir ../dist",
    "vercel-build": "cd client && npx vite build --outDir ../dist",
    "postinstall": "cd client && npm install"
  },
  "keywords": ["react", "express", "mongodb", "mongoose", "jwt", "custom-css", "wad-project"],
  "author": "WAD Student",
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^6.0.7"
  }
}
