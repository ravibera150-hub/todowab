# ==========================================
# WAD To-Do List Application — Server Config
# ==========================================

# Port where Express backend server runs
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# For local MongoDB: mongodb://127.0.0.1:27017/wad_todolist
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wad_todolist?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/wad_todolist

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=wad_super_secret_jwt_key_2026_academic_demo

# JWT Token Expiry (e.g. 7d = 7 days, 24h = 24 hours)
JWT_EXPIRE=7d
